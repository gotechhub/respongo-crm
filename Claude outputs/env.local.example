# Supabase — Frankfurt (eu-central-1) projesi
# Değerleri Supabase Dashboard > Project Settings > API sayfasından al.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key SADECE sunucu tarafında kullanılır, NEXT_PUBLIC_ önekini asla almaz.
SUPABASE_SERVICE_ROLE_KEY=

# Paraşüt entegrasyonu (V2 Revizeler bölüm F, sadece TR bölgesi) — herhangi
# rastgele, güçlü bir metin (ör. bir UUID) üret ve Vercel'e ekle, DB'ye asla yazma.
PARASUT_SETTINGS_ENC_KEY=

# Brevo bülten entegrasyonu (V2 Revizeler bölüm G) — herhangi rastgele, güçlü
# bir metin (ör. bir UUID) üret ve Vercel'e ekle, DB'ye asla yazma.
MARKETING_SETTINGS_ENC_KEY=

# Web sitesi (respongo.com) lead webhook'unun paylaşılan sırrı — respongo.com
# tarafında da aynı değer ayarlanmalı (/api/webhooks/website-lead isteğinde
# X-Webhook-Secret header'ı olarak gönderilir).
WEBSITE_LEAD_WEBHOOK_SECRET=

# JivoChat canlı sohbet webhook'unun paylaşılan sırrı (V2 Revizeler bölüm G.2) —
# JivoChat panelinden (Ayarlar > Webhooks) aynı değerle
# /api/webhooks/jivochat-chat?secret=... adresine POST tanımlanmalı.
JIVOCHAT_WEBHOOK_SECRET=
